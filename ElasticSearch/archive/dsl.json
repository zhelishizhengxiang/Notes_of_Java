#### 搜索功能相关

# 查询所有数据
GET /hotel/_search
{
  "query": {
    "match_all": {
      
    }
  }
}

# 单字段查询
GET /hotel/_search
{
  "query": {
    "match": {
      "all": "外滩如家"
    }
  }
}

# 多字段查询
GET /hotel/_search
{
  "query": {
    "multi_match": {
      "query": "外滩",
      "fields": ["brand","name","business"]
    }
  }
}

# 精准查询——根据词条精确值查询
GET /hotel/_search
{
  "query": {
    "term": {
      "city": {
        "value": "北京"
      }
    }
  }
}

# 精准查询——根据值得范围查询
GET /hotel/_search
{
  "query": {
    "range": {
      "price": {
        "gte": 1500,
        "lte": 2000
      }
    }
  }
}

# 地理坐标查询-distance查询
GET /hotel/_search
{
  "query": {
    "geo_distance":{
      "distance": "2000m",
      "location": "31.21,121.5"
    }
  }
}

# 算分函数查询
GET /hotel/_search
{
  "query": {
    "function_score": {
      "query": {
        "match": {
          "all": "外滩"
        }
      },
      "functions": [
        {
          "filter": {
            "term": {
              "brand": "如家"
            }
          },
          "weight": 10
        }
      ],
      "boost_mode": "replace"
    }
  }
}

# 复合查询
GET /hotel/_search
{
  "query": {
    "bool": {
      "must": [
        {"match": {
          "name": "如家"
        }}
      ], 
      "must_not": [
        {"range": {
          "price": {
            "gt": 400
          }
        }}
      ],
      "filter": [
        {"geo_distance": {
          "distance": "10km",
          "location": {
            "lat": 31.21,
            "lon": 121.5
          }
        }}
      ]
    }
  }
}

# 普通字段排序
GET /hotel/_search
{
  "query": {
    "match_all": {}
  }, 
  "sort": [
    {
      "score": {
        "order": "desc"
      }
    },
    {
      "price": {
        "order": "asc"
      }
    }
  ]
}

# 地理坐标字排序
GET /hotel/_search
{
  "query": {
    "match_all": {}
  }, 
  "sort": [
    {
      "_geo_distance": {
        "location": {
          "lat": 22.585056,
          "lon": 113.970059
        },
        "order": "asc"
      }
    }
  ]
}

# 分页查询
GET /hotel/_search
{
  "query": {
    "match_all": {}
  }, 
  "from": 190, 
  "size": 20, 
  "sort": [
    {
      "price":"asc"
    }
  ]
}

# 高亮查询
GET /hotel/_search
{
  "query": {
    "match": {
      "all": "外滩如家"
    }
  }, 
  "from": 0, 
  "size": 20, 
  "highlight": {
    "fields": {
      "name": {
        "require_field_match": "false"
      }
    }
  }
}

# 桶聚合功能
GET /hotel/_search
{
  "size": 0,
  "aggs": {
    "brandAggs": {
      "terms": {
        "field": "brand",
        "size": 20
      }
    }
  }
}

# 桶聚合自定义排序规则
GET /hotel/_search
{
  "size": 0,
  "aggs": {
    "brandAggs": {
      "terms": {
        "field": "brand",
        "order": {
          "_count": "asc"
        }, 
        "size": 20
      }
    }
  }
}


# 桶聚合限定聚合范围
GET /hotel/_search
{
  "query": {
    "range": {
      "price": {
        "lte": 200
      }
    }
  }, 
  "size": 0,
  "aggs": {
    "brandAggs": {
      "terms": {
        "field": "brand",
        "order": {
          "_count": "asc"
        }, 
        "size": 20
      }
    }
  }
}

#嵌套聚合metrics度量聚合,并且按照得分平均值做排序
GET /hotel/_search
{
  "size": 0,
  "aggs": {
    "brandAggs": {
      "terms": {
        "field": "brand",
        "order": {
          "score_aggs.avg": "desc"
        }, 
        "size": 20
      },
      "aggs": {
        "score_aggs": {
          "stats": {
            "field": "score"
          }
        }
      }
    }
  }
}

# 测试分词器
POST /test/_analyze
{
  "text": "如家酒店还不错",
  "analyzer":"my_analyzer"
}

// 自定义拼音分词器
PUT /test
{
  "settings": {
    "analysis": {
      "analyzer": { 
        "my_analyzer": { 
          "tokenizer": "ik_max_word",
          "filter": "py"
        }
      },
      "filter": {
        "py": { 
          "type": "pinyin",
          "keep_full_pinyin": false,
          "keep_joined_full_pinyin": true,
          "keep_original": true,
          "limit_first_letter_length": 16,
          "remove_duplicated_term": true,
          "none_chinese_pinyin_tokenize": false
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "name": {
        "type": "text",
        "analyzer": "my_analyzer",
        "search_analyzer": "ik_smart"
      }
    }
  }
}

