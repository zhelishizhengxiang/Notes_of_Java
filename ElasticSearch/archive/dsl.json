# 创建索引库
PUT /heima 
{
  "mappings":{
    "properties":{
      "info":{
        "type":"text",
        "analyzer":"ik_smart"
      },
      "email":{
        "type":"keyword",
        "index":false
      },
      "name":{
          "type":"object",
          "properties":{
            "firstName":{
              "type":"keyword"
            },
            "lastName":{
              "type":"keyword"
            }
          }
      }
    }
  }
}

